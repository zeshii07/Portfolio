# ─────────────────────────────────────────────────────────────
# Contact endpoint — Nodemailer + Gmail SMTP
# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Gmail SMTP host. Use smtp.gmail.com for personal Google accounts.
SMTP_HOST=smtp.gmail.com

# 465 → implicit TLS (recommended). 587 → STARTTLS upgrade.
SMTP_PORT=465

# Your Gmail address. This MUST equal CONTACT_FROM_EMAIL because
# Gmail rejects From values that differ from the authenticated user.
SMTP_USER=zeeshansultan785@gmail.com

# 16-character Gmail App Password — NOT your account password.
# Create one at https://myaccount.google.com/apppasswords
# (2-Step Verification must be enabled first).
SMTP_PASS=

# Verified sender shown in the "From" header.
# For Gmail this MUST equal SMTP_USER.
CONTACT_FROM_EMAIL=zeeshansultan785@gmail.com

# Inbox that receives contact form submissions.
# Usually the same as SMTP_USER.
CONTACT_TO_EMAIL=zeeshansultan785@gmail.com

# Public site URL — used as metadataBase for SEO/Open Graph.
NEXT_PUBLIC_SITE_URL=https://zeeshandeveloper.vercel.app

# ─────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────
# 1. NEVER commit .env.local. The repository's .gitignore already
#    excludes it.
# 2. If SMTP_PASS is empty, the /api/contact route falls back to a
#    safe dev log so the form still works in previews. Real email
#    delivery only happens once SMTP_PASS is set.
# 3. The route is rate-limited per IP and protected by a honeypot
#    field. See src/lib/portfolio/rate-limit.ts and validation.ts.
# ─────────────────────────────────────────────────────────────
