# Contact endpoint configuration (Phase 1 backend)
# Copy this file to .env.local and fill in the values for your deployment.

# Transactional email provider API key (e.g. Resend, Postmark, SendGrid)
EMAIL_API_KEY=

# Provider identifier used by the email helper to pick the right integration
EMAIL_PROVIDER=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=hello@zeeshan.dev

# Verified sender address shown in the "From" header
CONTACT_FROM_EMAIL=portfolio@zeeshan.dev

# Optional: site URL used in metadataBase for SEO/sitemap
NEXT_PUBLIC_SITE_URL=https://zeeshan.dev
