# Contact endpoint configuration
# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings → Environment Variables.

# Transactional email provider API key (e.g. Resend, Postmark, SendGrid)
EMAIL_API_KEY=

# Provider identifier used by the email helper
EMAIL_PROVIDER=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=zeeshansultan785@gmail.com

# Verified sender address shown in the "From" header
CONTACT_FROM_EMAIL=portfolio@yourverifieddomain.com

# Site URL used in metadataBase for SEO
NEXT_PUBLIC_SITE_URL=https://developerzeeshan.vercel.app
